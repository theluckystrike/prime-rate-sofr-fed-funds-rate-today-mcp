  },
  "homepage": "https://www.mcpstamp.com/servers/",
  "bin": {
    "prime-rate-sofr-fed-funds-rate-today-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
