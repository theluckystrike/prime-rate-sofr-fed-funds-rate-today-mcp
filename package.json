{
  "name": "prime-rate-sofr-fed-funds-rate-today-mcp",
  "version": "1.0.0",
  "description": "MCP server for the prime rate, SOFR and the fed funds rate today: the federal funds target range and effective rate, the prime rate, SOFR with its 30, 90 and 180 day averages and index, rate history, every Fed rate change, and a loan rate calculator for prime or SOFR plus a margin. Read live from the New York Fed. No API key.",
  "type": "module",
  "license": "MIT",
  "author": "theluckystrike",
